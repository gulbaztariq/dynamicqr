APP_NAME="Dynamic QR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Reporting groups "today" by this timezone — set it to where the business
# actually operates, e.g. Asia/Karachi.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite runs out of the box. For production switch to mysql and fill these in.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dynamicqr
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Dynamic QR
# -----------------------------------------------------------------------------

# Customers are created by an administrator when they buy hardware, so public
# sign-up is off by default.
ALLOW_PUBLIC_REGISTRATION=false

# The URL segment printed codes use: https://your-domain.com/q/AB12CD3
# Shorter means a less dense QR image. Changing it breaks already-printed codes.
QR_REDIRECT_PREFIX=q

# Length of the printed short code. 7 characters from a 31-character
# unambiguous alphabet is ~27 billion combinations.
QR_CODE_LENGTH=7

# Largest batch that can be generated in a single request.
QR_MAX_BATCH_QUANTITY=2000

# Visitor IPs are never stored — only an HMAC of them, used to count unique
# scans. Set this to a long random string and never change it afterwards, or
# historical unique counts stop lining up.
QR_IP_SALT=

# Hours before the same visitor counts as a new unique scan again.
QR_UNIQUE_WINDOW_HOURS=24

# Country lookup. Leave false when behind Cloudflare: the CF-IPCountry header
# is used automatically and costs nothing. Turning this on calls an external
# service from a queued job.
QR_GEO_LOOKUP=false

# Default printed artwork.
QR_DEFAULT_SIZE=512
QR_DEFAULT_MARGIN=16
QR_DEFAULT_FOREGROUND="#0f172a"
QR_DEFAULT_BACKGROUND="#ffffff"

# Extra hosts a destination URL may never point at (comma separated). Your own
# APP_URL host is always blocked.
QR_BLOCKED_REDIRECT_HOSTS=
